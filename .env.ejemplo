# Copia este archivo a .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub.

# --- Supabase (botón Connect > Framework, y Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (empieza por sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (empieza por sb_secret_): SOLO servidor,
# jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos (botón Connect > ORM > Prisma) ---
# La app: "Transaction pooler", puerto 6543.
DATABASE_URL=
# Las migraciones de Prisma: "Session pooler", puerto 5432.
DIRECT_URL=
